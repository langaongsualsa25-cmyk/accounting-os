# Sandbox only. Copy to .env and change every password before use.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# PEM public key of the Keycloak realm (Realm settings → Keys → RS256 → Public key),
# wrapped as -----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:8080/realms/accounting-os
JWT_AUDIENCE=accounting-os-api
